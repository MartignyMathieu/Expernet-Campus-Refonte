# Développement local SANS Docker (SQLite). Avec Docker, utiliser le .env.example à la racine.
APP_NAME=Expernet-ENT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_TIMEZONE=Indian/Reunion

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000

MFA_OBLIGATOIRE_POUR=admin,formateur
EMARGEMENT_DUREE_MINUTES=15
ASSIDUITE_SEUIL_ALERTE=80

SEED_DEMO=true
# à définir : mot de passe des comptes de démonstration
DEMO_PASSWORD=
