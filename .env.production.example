# Production : copier en .env.production (jamais versionné) et renseigner toutes les valeurs « à définir ».
APP_NAME=Expernet-ENT
# à définir : URL publique en HTTPS
APP_URL=https://ent.exemple.re
# à définir : clé générée par « docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show »
APP_KEY=
APP_LOCALE=fr
APP_TIMEZONE=Indian/Reunion
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_DATABASE=expernet
DB_USERNAME=expernet
# à définir : mot de passe long et aléatoire
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
# à définir : domaine public (sans https://)
SANCTUM_STATEFUL_DOMAINS=ent.exemple.re

# à définir : serveur SMTP réel (les e-mails de notification partent d'ici)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=ne-pas-repondre@exemple.re
MAIL_FROM_NAME="Expernet Campus"

MFA_OBLIGATOIRE_POUR=admin,formateur
EMARGEMENT_DUREE_MINUTES=15
ASSIDUITE_SEUIL_ALERTE=80

# Sauvegardes : intervalle en secondes (86400 = 24 h) et durée de conservation en jours
SAUVEGARDE_INTERVALLE=86400
SAUVEGARDE_JOURS=14
