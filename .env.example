# Copier ce fichier en .env (jamais versionné) puis renseigner les valeurs vides marquées « à définir ».
# Attention : pas de commentaire en fin de ligne (non supporté par Docker Compose).
APP_NAME=Expernet-ENT
APP_ENV=local
# APP_KEY : laissé vide, il est généré au premier démarrage du conteneur backend
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_TIMEZONE=Indian/Reunion

DB_DATABASE=expernet
DB_USERNAME=expernet
# à définir : mot de passe local de la base
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# true en production (HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3000,127.0.0.1:8080

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025

# Règles métier
MFA_OBLIGATOIRE_POUR=admin,formateur
EMARGEMENT_DUREE_MINUTES=15
ASSIDUITE_SEUIL_ALERTE=80

# Données de démonstration (personnes fictives)
SEED_DEMO=true
# à définir : mot de passe des comptes de démo (si vide, un mot de passe aléatoire est affiché dans les logs du backend)
DEMO_PASSWORD=
